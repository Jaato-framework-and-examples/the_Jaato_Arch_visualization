# jaato daemon env for the python-sdk examples.
# Copy to `.env` (git-ignored) and fill in your key:  cp .env.example .env
# _config.py passes this file to the daemon via env_file, and both _config.AUTH
# and each declarative profile reference the key as ${JAATO_OPENROUTER_API_KEY}.
#
# Get a key from https://openrouter.ai/settings/keys (sk-or-...).
#
# NOTE: the examples used to reference the key as "pass://jaato/openrouter/api-key".
# That secret-URI scheme is resolved only by the private jaato-premium package;
# on a public checkout it fails SILENTLY — jaato warns and then uses the literal
# URI string as the key, so OpenRouter returns an auth error that never mentions
# secret resolution. Use the plain-key env-var form below. (If you have
# jaato-premium, you may set JAATO_OPENROUTER_API_KEY=pass://jaato/openrouter/api-key.)
JAATO_OPENROUTER_API_KEY=

# These two lines just name the provider + model the examples run against. The
# comparison docs show `gpt-4o` / `openai`; the examples substitute a cheap,
# locally-funded OpenRouter model. See README.md ("Standing substitutions").
JAATO_PROVIDER=openrouter
MODEL_NAME=google/gemini-2.5-flash
